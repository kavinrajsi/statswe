# Copy to .env.local and fill in. Never commit real values.

# Facebook app (developers.facebook.com → App settings → Basic)
FB_APP_ID=
FB_APP_SECRET=
# Local: the ngrok https URL from `npm run tunnel` + callback path.
# Must match Facebook Login → Settings → Valid OAuth Redirect URIs.
FB_REDIRECT_URI=https://<your-ngrok-domain>/api/auth/facebook/callback

# openssl rand -base64 32
SESSION_SECRET=
# openssl rand -base64 32 (must decode to 32 bytes)
TOKEN_ENC_KEY=

# Neon Postgres connection string
DATABASE_URL=

# Vercel Cron bearer secret
CRON_SECRET=
